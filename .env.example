# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Sistema de Gestión de Chocolatería Gourmet con CRUD e IA Local (Ollama)
# ==============================================================================

# Clave secreta de Django (en producción usar una clave segura)
DJANGO_SECRET_KEY=tu-clave-secreta-django-aqui
DEBUG=True

# Configuración del Proveedor de IA:
# - 'ollama'     : Modo 100% Local sin conexión a internet ni costos
# - 'openrouter' : Modo Nube con OpenRouter API (opcional para pruebas de alta velocidad)
AI_PROVIDER=ollama

# Configuración de Ollama Local (API Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=productos-qwen2.5
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=60.0
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=150

# Configuración opcional para OpenRouter (si AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=tu-clave-openrouter-sk-or-v1-aqui
OPENROUTER_MODEL=openrouter/free

# Rutas de base de conocimiento (RAG local)
RAG_SOURCE_DIR=knowledge_base
RAG_MARKDOWN_DIR=knowledge_markdown
RAG_STORAGE_DIR=rag_storage
RAG_SIMILARITY_TOP_K=4
